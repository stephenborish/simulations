<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,1,0" rel="stylesheet">

<style>
    body { font-family: 'Inter', sans-serif; }
    
    /* Main Container */
    .main-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        padding: 20px;
        height: 100%;
        width: 100%;
    }

    /* Grid Setup */
    .periodic-grid {
        display: grid;
        grid-template-columns: repeat(18, minmax(45px, 1fr)); 
        grid-template-rows: repeat(7, minmax(45px, 1fr));
        gap: 6px; 
        width: fit-content;
    }
    
    /* Cell Styling */
    .cell { 
        aspect-ratio: 1/1; 
        display: flex; 
        flex-direction: column; 
        align-items: center; 
        justify-content: center;
        border: 1px solid #cbd5e1;
        background-color: white;
        border-radius: 6px;
        cursor: default;
        position: relative;
        transition: all 0.2s ease; /* Smoother transition for color changes */
        user-select: none;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
    }
    
    .cell:hover { 
        transform: scale(1.35); 
        z-index: 50; 
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2); 
        border-color: #3b82f6;
    }

    /* Specific Visual Markers */
    .stair-r { border-right: 3px solid #dc2626 !important; } 
    .stair-b { border-bottom: 3px solid #dc2626 !important; }

    /* Animations */
    .fade-in { animation: fadeIn 0.4s ease-out forwards; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    /* Scrollbar */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: #f1f5f9; }
    ::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 3px; }
</style>
</head>
