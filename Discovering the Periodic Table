                            </div>
                        </button>

                        <button onclick="highlightType('noble')" class="w-full text-left p-3 rounded-lg bg-purple-50 border border-purple-200 hover:bg-purple-100 transition-colors flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-purple-300 border border-purple-400 flex items-center justify-center font-bold text-purple-800">NG</div>
                            <div>
                                <div class="font-bold text-purple-900">Noble Gases</div>
                                <div class="text-xs text-purple-800">Group 18. Unreactive.</div>
                            </div>
                        </button>
                    </div>
                </div>
            `,
            action: () => {
                document.getElementById('legendContainer').classList.remove('hidden');
                resetView();
            }
        },
        {
            title: "5. Chemical Families",
            render: () => `
                <div class="fade-in space-y-4">
                    <p class="text-slate-600">Find these 5 specific families on the table:</p>
                    
                    <div class="grid grid-cols-1 gap-2 text-sm">
                        <div class="p-2.5 bg-red-50 border-l-4 border-red-400 hover:bg-red-100 cursor-pointer transition-colors" onmouseenter="highlightFamily('alkali')" onmouseleave="resetView()">
                            <strong class="text-red-900">Alkali Metals</strong> 
                            <span class="block text-xs text-slate-500">Group 1 (except H). Very reactive.</span>
                        </div>
                        <div class="p-2.5 bg-orange-50 border-l-4 border-orange-400 hover:bg-orange-100 cursor-pointer transition-colors" onmouseenter="highlightFamily('alkaline')" onmouseleave="resetView()">
                            <strong class="text-orange-900">Alkaline Earth Metals</strong> 
                            <span class="block text-xs text-slate-500">Group 2.</span>
                        </div>
                        <div class="p-2.5 bg-yellow-50 border-l-4 border-yellow-400 hover:bg-yellow-100 cursor-pointer transition-colors" onmouseenter="highlightFamily('transition')" onmouseleave="resetView()">
                            <strong class="text-yellow-900">Transition Metals</strong> 
                            <span class="block text-xs text-slate-500">Groups 3-12.</span>
                        </div>
                        <div class="p-2.5 bg-green-50 border-l-4 border-green-400 hover:bg-green-100 cursor-pointer transition-colors" onmouseenter="highlightFamily('halogen')" onmouseleave="resetView()">
                            <strong class="text-green-900">Halogens</strong> 
                            <span class="block text-xs text-slate-500">Group 17. Reactive non-metals.</span>
                        </div>
                        <div class="p-2.5 bg-purple-50 border-l-4 border-purple-400 hover:bg-purple-100 cursor-pointer transition-colors" onmouseenter="highlightFamily('noble')" onmouseleave="resetView()">
                            <strong class="text-purple-900">Noble Gases</strong> 
                            <span class="block text-xs text-slate-500">Group 18. Inert (stable).</span>
                        </div>
                    </div>
                </div>
            `,
            action: resetView
        },
        {
            title: "6. Diatomic Elements",
            render: () => `
                <div class="fade-in space-y-5">
                    <p class="text-slate-600"><strong>Diatomic elements</strong> are so reactive they never exist alone in nature (e.g. O₂).</p>
                    
                    <div class="bg-indigo-600 text-white rounded-xl p-6 text-center shadow-lg cursor-pointer transform hover:scale-105 transition-transform" onmouseenter="highlightDiatomic()" onmouseleave="resetView()">
                        <h3 class="text-2xl font-black tracking-widest text-indigo-100 mb-2">THE "7" + 1</h3>
                        <p class="text-xs uppercase font-bold text-indigo-300 mb-4">Make a "7" starting at Nitrogen</p>
                        
                        <div class="flex flex-wrap justify-center gap-2 font-mono font-bold">
                            <span class="bg-indigo-800 px-2 py-1 rounded">N</span>
                            <span class="bg-indigo-800 px-2 py-1 rounded">O</span>
                            <span class="bg-indigo-800 px-2 py-1 rounded">F</span>
                            <span class="bg-indigo-800 px-2 py-1 rounded">Cl</span>
                            <span class="bg-indigo-800 px-2 py-1 rounded">Br</span>
                            <span class="bg-indigo-800 px-2 py-1 rounded">I</span>
                            <span class="bg-yellow-600 px-2 py-1 rounded">+ H</span>
                        </div>
                    </div>
                    <p class="text-xs text-center text-slate-400">Hover the card to see the shape.</p>
                </div>
            `,
            action: highlightDiatomic
        }
    ];

    // --- Core Functions ---

    function init() {
        renderTable();
        updateNavDots();
        loadStep(0);
    }

    function renderTable() {
        const grid = document.getElementById('mainGrid');
        
        // Render 18x7 Main Grid
        for (let r = 1; r <= 7; r++) {
            for (let c = 1; c <= 18; c++) {
                const cell = document.createElement('div');
                cell.className = 'cell';
                
                // Gap Logic
                let isGap = false;
                if (r === 1 && c > 1 && c < 18) isGap = true;
                if ((r === 2 || r === 3) && c > 2 && c < 13) isGap = true;

                const el = gridMap[`${r}-${c}`];

                if (isGap && !el && !((r===6||r===7)&&c===3)) {
                    cell.style.visibility = 'hidden';
                    cell.style.pointerEvents = 'none';
                } else if (el) {
                    cell.id = `el-${el.s}`;
                    cell.dataset.g = el.g;
                    cell.dataset.p = el.p;
                    cell.dataset.cat = el.cat;
                    
                    cell.innerHTML = `
                        <span class="absolute top-0.5 left-1 text-[9px] font-bold text-slate-400">${el.n}</span>
                        <span class="font-bold text-sm text-slate-800">${el.s}</span>
                    `;

                    // Staircase Borders
                    const stairRight = ['B','Si','Ge','As','Sb','Te','Po'];
                    const stairBottom = ['B','Si','Ge','As','Sb','Te'];
                    if (stairRight.includes(el.s)) cell.classList.add('stair-r');
                    if (stairBottom.includes(el.s)) cell.classList.add('stair-b');

                    cell.onmouseenter = () => showInfo(el);
                    cell.onmouseleave = () => {};
                } else if ((r===6 || r===7) && c===3) {
                     // Detached placeholders (Just visual gap markers)
                     cell.style.backgroundColor = 'transparent';
                     cell.style.border = '1px dashed #cbd5e1';
                     cell.innerHTML = `<span class="text-[8px] text-slate-400 font-bold">${r===6?'57-71':'89-103'}</span>`;
                }
                grid.appendChild(cell);
            }
        }
    }

    function updateNavDots() {
        const container = document.getElementById('navDots');
        container.innerHTML = steps.map((_, i) => `
            <div class="h-1.5 rounded-full transition-all duration-300 ${i === currentStep ? 'w-4 bg-indigo-600' : 'w-1.5 bg-slate-300'}"></div>
        `).join('');
        
        // Progress Bar
        const pct = ((currentStep + 1) / steps.length) * 100;
        document.getElementById('progressBar').style.width = `${pct}%`;
    }

    function nav(dir) {
        const next = currentStep + dir;
        if (next >= 0 && next < steps.length) {
            loadStep(next);
        }
    }

    function loadStep(idx) {
        currentStep = idx;
        const data = steps[idx];
        
        document.getElementById('lessonContainer').innerHTML = `
            <h2 class="text-2xl font-bold text-slate-800 mb-2 tracking-tight">${data.title}</h2>
            ${data.render()}
        `;
        
        updateNavDots();
        
        // Buttons
        document.getElementById('prevBtn').disabled = idx === 0;
        document.getElementById('nextBtn').disabled = idx === steps.length - 1;
        document.getElementById('nextBtn').innerHTML = idx === steps.length - 1 ? 
            `Finish <span class="material-symbols-outlined">check</span>` : 
            `Next <span class="material-symbols-outlined">arrow_forward</span>`;

        document.getElementById('legendContainer').classList.add('hidden');
        if(data.action) data.action();
    }

    // --- Visual Logic ---

    function resetView() {
        document.querySelectorAll('.cell').forEach(c => {
            if (c.style.visibility !== 'hidden' && c.id) {
                c.style.backgroundColor = 'white';
                c.style.opacity = '1';
                c.style.borderColor = '#cbd5e1';
                c.style.transform = '';
                c.style.zIndex = '0';
                c.style.color = '';
                c.style.boxShadow = '';
                
                // Reset internal text colors
                const n = c.querySelector('span:first-child');
                const s = c.querySelector('span:last-child');
                if(n) n.classList.replace('text-white', 'text-slate-400');
                if(s) s.classList.replace('text-white', 'text-slate-800');
            }
        });
        document.getElementById('infoBox').classList.add('opacity-0', '-translate-y-2');
    }

    function highlightElement(s) {
        resetView();
        document.querySelectorAll('.cell').forEach(c => { if(c.id) c.style.opacity = '0.1'; });
        const el = document.getElementById(`el-${s}`);
        if(el) {
            el.style.opacity = '1';
            el.style.backgroundColor = '#fef08a';
            el.style.transform = 'scale(1.3)';
            el.style.zIndex = '50';
            el.style.borderColor = '#000';
        }
    }

    function highlightGroups() {
        resetView();
        // Bold Blue Pillars
        document.querySelectorAll('.cell').forEach(c => {
            if(c.id) {
                const g = parseInt(c.dataset.g);
                // Alternating distinct blues
                if(g % 2 === 0) c.style.backgroundColor = '#2563eb'; // Blue 600
                else c.style.backgroundColor = '#60a5fa'; // Blue 400
                
                c.style.borderColor = '#1e3a8a'; // Dark Blue Border
                
                // Make text white for contrast
                const n = c.querySelector('span:first-child');
                const s = c.querySelector('span:last-child');
                if(n) n.classList.replace('text-slate-400', 'text-white');
                if(s) s.classList.replace('text-slate-800', 'text-white');
            }
        });
    }

    function highlightPeriods() {
        resetView();
        // Bold Red Rows
        document.querySelectorAll('.cell').forEach(c => {
            if(c.id) {
                const p = parseInt(c.dataset.p);
                // Alternating distinct reds/pinks
                if(p % 2 === 0) c.style.backgroundColor = '#e11d48'; // Rose 600
                else c.style.backgroundColor = '#fb7185'; // Rose 400
                
                c.style.borderColor = '#9f1239'; // Dark Red Border
                
                // Make text white for contrast
                const n = c.querySelector('span:first-child');
                const s = c.querySelector('span:last-child');
                if(n) n.classList.replace('text-slate-400', 'text-white');
                if(s) s.classList.replace('text-slate-800', 'text-white');
            }
        });
    }

    function highlightValence(g) {
        resetView();
        document.querySelectorAll(`.cell[data-g="${g}"]`).forEach(c => {
            c.style.backgroundColor = '#c7d2fe'; // indigo-200
            c.style.borderColor = '#4f46e5';
        });
        document.querySelectorAll(`.cell:not([data-g="${g}"])`).forEach(c => {
             if(c.id) c.style.opacity = '0.1'; // Faded more for drama
        });
    }

    function highlightRange(start, end) {
        resetView();
        document.querySelectorAll('.cell').forEach(c => {
            if(!c.id) return;
            const g = parseInt(c.dataset.g);
            if(g >= start && g <= end) {
                c.style.backgroundColor = '#fef08a'; // yellow-200
                c.style.borderColor = '#ca8a04';
            } else {
                c.style.opacity = '0.1'; // Faded more
            }
        });
    }

    function highlightType(type) {
        resetView();
        const colors = { metal: '#fef08a', nonmetal: '#bbf7d0', noble: '#e9d5ff' };
        document.querySelectorAll('.cell').forEach(c => {
            if(!c.id) return;
            const cat = c.dataset.cat;
            let match = false;
            if(type === 'metal' && cat === 'metal') match = true;
            if(type === 'nonmetal' && cat === 'nonmetal') match = true;
            if(type === 'noble' && cat === 'noble') match = true;

            if(match) {
                c.style.backgroundColor = colors[type];
                c.style.borderColor = '#475569';
            } else {
                c.style.opacity = '0.1'; // Faded more
            }
        });
    }

    function highlightFamily(fam) {
        resetView();
        const colors = { alkali: '#fca5a5', alkaline: '#fdba74', transition: '#fde047', halogen: '#86efac', noble: '#d8b4fe' };
        
        const check = (g, s) => {
            if(fam === 'transition') return g>=3 && g<=12;
            if(fam === 'alkali') return g===1 && s!=='H';
            if(fam === 'alkaline') return g===2;
            if(fam === 'halogen') return g===17;
            if(fam === 'noble') return g===18;
            return false;
        };

        document.querySelectorAll('.cell').forEach(c => {
            if(!c.id) return;
            const g = parseInt(c.dataset.g);
            const s = c.innerText.split('\n')[1];
            
            if(check(g, s)) {
                c.style.backgroundColor = colors[fam];
                c.style.borderColor = '#475569';
            } else {
                c.style.opacity = '0.1'; // Faded more
            }
        });
    }

    function highlightDiatomic() {
        resetView();
        const diatoms = ['H','N','O','F','Cl','Br','I'];
        document.querySelectorAll('.cell').forEach(c => {
            if(!c.id) return;
            const s = c.innerText.split('\n')[1];
            if(diatoms.includes(s)) {
                c.style.backgroundColor = '#6366f1';
                c.style.color = 'white';
                c.style.borderColor = '#312e81';
                c.style.transform = 'scale(1.1)';
                c.style.zIndex = '50';
            } else {
                c.style.opacity = '0.1'; // Faded more
            }
        });
    }

    function showInfo(el) {
        const box = document.getElementById('infoBox');
        box.classList.remove('opacity-0', '-translate-y-2');
        
        document.getElementById('infoSymbol').innerText = el.s;
        document.getElementById('infoName').innerText = el.name;
        document.getElementById('infoNum').innerText = el.n;

        let content = `<p>Group ${el.g} • Period ${el.p}</p>`;
        
        if(currentStep === 3) { // Valence
            let v = el.g;
            if(el.g > 12) v = el.g - 10;
            let text = `Valence: ${v}`;
            let color = 'text-indigo-600';
            if(el.g >= 3 && el.g <= 12) { text = 'Valence: Varies'; color = 'text-yellow-600'; }
            if(el.s === 'He') { text = 'Valence: 2'; color = 'text-indigo-600'; }
            content += `<p class="font-bold ${color}">${text}</p>`;
        } else if (currentStep === 4) { // Classify
            let type = 'Metal';
            if(el.cat === 'nonmetal') type = 'Non-Metal';
            if(el.cat === 'noble') type = 'Noble Gas';
            content += `<p class="font-bold text-slate-700">${type}</p>`;
        }

        document.getElementById('infoDetails').innerHTML = content;
    }

    init();
</script>

</body>
</html>
